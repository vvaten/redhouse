[Unit]
Description=RedHouse Heating Program Execution
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/opt/redhouse
# --dry-run until the Phase 6 cutover: logs the commands it would send
# and skips both the pump command and its own InfluxDB write. Removing
# it is what hands pump control to redhouse, so remove it deliberately.
ExecStart=/opt/redhouse/venv/bin/python /opt/redhouse/execute_heating_program_v2.py --dry-run
StandardOutput=journal
StandardError=journal
SyslogIdentifier=redhouse-execute-program

[Install]
WantedBy=multi-user.target
