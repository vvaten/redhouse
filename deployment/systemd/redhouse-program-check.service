[Unit]
Description=RedHouse Heating Program Presence Check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/opt/redhouse
ExecStart=/opt/redhouse/venv/bin/python /opt/redhouse/check_program.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=redhouse-program-check

[Install]
WantedBy=multi-user.target
