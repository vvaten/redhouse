[Unit]
Description=RedHouse Health Check Timer

[Timer]
# Off the quarter hour. All 10 read timeouts in the 7 days to
# 2026-09-22 landed on :00, :15, :30 or :45, where execute-program and
# the every-minute collectors start in the same second.
# In UTC: on local time systemd skips the repeated autumn hour
OnCalendar=*:14/15 UTC
AccuracySec=1s

[Install]
WantedBy=timers.target
