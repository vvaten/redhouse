[Unit]
Description=RedHouse Heat Pump State Restore
After=network-online.target redhouse-program-fallback.service
Wants=network-online.target
# The executor must not drive the pump while the restore does
Before=redhouse-execute-program.service

[Service]
Type=oneshot
User=pi
WorkingDirectory=/opt/redhouse
# Runs once at boot: the relay board may not keep its state across a
# reboot, and the next program command can be hours away.
ExecStart=/opt/redhouse/venv/bin/python /opt/redhouse/restore_pump_state.py
# Up to 17 min of clock sync waits plus two applies with relay retries
TimeoutStartSec=1500
StandardOutput=journal
StandardError=journal
SyslogIdentifier=redhouse-pump-restore

[Install]
WantedBy=multi-user.target
