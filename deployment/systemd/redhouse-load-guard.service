[Unit]
Description=RedHouse Load Guard
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/opt/redhouse
# The load_guard mode in config.yaml decides: dry_run logs, act sheds
ExecStart=/opt/redhouse/venv/bin/python /opt/redhouse/run_load_guard.py
TimeoutStartSec=45
StandardOutput=journal
StandardError=journal
SyslogIdentifier=redhouse-load-guard

[Install]
WantedBy=multi-user.target
